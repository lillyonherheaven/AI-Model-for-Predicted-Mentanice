import shap

# SHAP needs feature names to label plots correctly, so wrap the
# selected/scaled arrays back into DataFrames using the selected column names
X_train_selected_df = pd.DataFrame(X_train_selected, columns=selected_features)
X_test_selected_df = pd.DataFrame(X_test_selected, columns=selected_features)

# TreeExplainer works natively with tree-based models (Decision Tree, Random Forest)
explainer_rf = shap.TreeExplainer(rf)
shap_values_rf = explainer_rf.shap_values(X_test_selected_df)

# For binary classification, shap_values can come back as a list [class0, class1]
# or as a single 2D array depending on the SHAP version, handle both cases
if isinstance(shap_values_rf, list):
    shap_values_rf_class1 = shap_values_rf[1]
else:
    shap_values_rf_class1 = shap_values_rf

# Global feature importance: summary bar plot
plt.figure()
shap.summary_plot(
    shap_values_rf_class1,
    X_test_selected_df,
    plot_type="bar",
    show=False
)
plt.title("SHAP Feature Importance - Random Forest")
plt.tight_layout()
plt.show()

# Global feature impact: beeswarm summary plot (shows direction and magnitude)
plt.figure()
shap.summary_plot(
    shap_values_rf_class1,
    X_test_selected_df,
    show=False
)
plt.title("SHAP Summary Plot - Random Forest")
plt.tight_layout()
plt.show()

# Local explainability: waterfall plot for a single test instance
sample_idx = 0
expected_value_rf = (
    explainer_rf.expected_value[1]
    if isinstance(explainer_rf.expected_value, (list, np.ndarray))
    else explainer_rf.expected_value
)

shap_explanation_rf = shap.Explanation(
    values=shap_values_rf_class1[sample_idx],
    base_values=expected_value_rf,
    data=X_test_selected_df.iloc[sample_idx].values,
    feature_names=X_test_selected_df.columns.tolist()
)

plt.figure()
shap.plots.waterfall(shap_explanation_rf, show=False)
plt.title(f"SHAP Waterfall - Random Forest (Test Instance {sample_idx})")
plt.tight_layout()
plt.show()

